{
  "name": "snoochies",
  "version": "0.0.3",
  "description": "Cute kid. He's yours?",
  "homepage": "https://github.com/erwstout/snoochies#readme",
  "bugs": {
    "url": "https://github.com/erwstout/snoochies/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwstout/snoochies.git"
  },
  "license": "MIT",
  "author": "Eric Stout <ericwstout@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "npm-run-all -p dev:api dev:frontend",
    "dev:api": "cd api && tsx watch src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "npm-run-all build:api build:frontend build:cli",
    "build:api": "tsc -p api/tsconfig.json && tsc-alias -p api/tsconfig.json",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck": "npm-run-all typecheck:api typecheck:frontend typecheck:cli",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "typecheck:cli": "tsc -p packages/cli/tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "start": "node api/dist/index.js",
    "prepare": "husky install",
    "pack:cli": "npm -w get-snoochies run prepack && npm pack -w get-snoochies",
    "format": "prettier --write .",
    "lint": "eslint \"api/src/**/*.{ts,tsx}\" \"frontend/src/**/*.{ts,tsx}\" \"packages/cli/src/**/*.ts\"",
    "test": "npm-run-all lint test:frontend test:api",
    "test:frontend": "jest --config frontend/jest.config.ts --runInBand --passWithNoTests",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest --config api/jest.config.ts --runInBand --passWithNoTests",
    "test:cli": "NODE_OPTIONS=--experimental-vm-modules jest --config packages/cli/jest.config.ts --runInBand --passWithNoTests"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,scss,html}": "prettier --write"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@tanstack/react-query": "^5.90.16",
    "@types/pino-http": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.13.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.3.5"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
