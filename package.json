{
  "name": "snoochies",
  "version": "0.0.1",
  "description": "Cute kid. He's yours?",
  "homepage": "https://github.com/erwstout/snoochies#readme",
  "bugs": {
    "url": "https://github.com/erwstout/snoochies/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwstout/snoochies.git"
  },
  "license": "MIT",
  "author": "Eric Stout <ericwstout@gmail.com>",
  "type": "module",
  "main": "api/dist/index.js",
  "scripts": {
    "dev": "npm-run-all -p dev:api dev:frontend",
    "dev:api": "tsx watch api/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "npm-run-all build:api build:frontend",
    "build:api": "tsc -p api/tsconfig.json && tsc-alias -p api/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "db:migrate": "tsx node_modules/knex/bin/cli.js --knexfile api/knexfile.ts migrate:latest",
    "db:rollback": "tsx node_modules/knex/bin/cli.js --knexfile api/knexfile.ts migrate:rollback",
    "db:make": "tsx node_modules/knex/bin/cli.js --knexfile api/knexfile.ts migrate:make",
    "db:seed": "tsx node_modules/knex/bin/cli.js --knexfile api/knexfile.ts seed:run",
    "start": "node api/dist/index.js",
    "prepare": "husky install",
    "format": "prettier --write .",
    "lint": "eslint \"api/src/**/*.{ts,tsx}\" \"frontend/src/**/*.{ts,tsx}\"",
    "test": "npm-run-all lint test:frontend test:api",
    "test:frontend": "jest --config frontend/jest.config.ts --runInBand --passWithNoTests",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest --config api/jest.config.ts --runInBand --passWithNoTests"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,scss,html}": "prettier --write"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@types/pino-http": "^5.8.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  }
}
