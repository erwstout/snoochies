# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snoochies
# Or use discrete settings instead of DATABASE_URL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=snoochies
# Set to true to enable SSL (with rejectUnauthorized: false)
PGSSL=false

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# API
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000
