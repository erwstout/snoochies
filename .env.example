# Database (used by Prisma; safe default even if Postgres is not running yet)
# For dockerized scaffolds, copy .env.docker.example instead to point at the Compose Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snoochies

# Comma-separated allowed origins for cross-origin calls (leave blank to disable CORS)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# API
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000
